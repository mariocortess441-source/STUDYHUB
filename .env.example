PORT=3000
# Public URL used to generate share links when behind a proxy/deployment.
PUBLIC_BASE_URL=http://localhost:3000
# Maximum upload size in bytes (default 2 GiB)
MAX_UPLOAD_BYTES=2147483648

# Optional email delivery (without SMTP, the app still creates a copyable link).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional path to LibreOffice executable; "soffice" is used by default.
LIBREOFFICE_BIN=soffice
